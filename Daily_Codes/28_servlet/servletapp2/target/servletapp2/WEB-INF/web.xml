<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         version="4.0">

    <servlet>
        <servlet-name>Hello</servlet-name>
        <servlet-class>pdevelopment.HelloServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>Hello</servlet-name>
        <url-pattern>/hello</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MyServlet</servlet-name>
        <servlet-class>pdevelopment.MyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyServlet</servlet-name>
        <url-pattern>/myservlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ServletLifyCycleDemo</servlet-name>
        <servlet-class>pdevelopment.ServletLifyCycleDemo</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletLifyCycleDemo</servlet-name>
        <url-pattern>/servletlifecycle</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ReadingRequestParameters</servlet-name>
        <servlet-class>pdevelopment.ReadingRequestParameter</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReadingRequestParameters</servlet-name>
        <url-pattern>/readingrequestparameters</url-pattern>
    </servlet-mapping>

</web-app>

